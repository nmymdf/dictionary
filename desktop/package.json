{
  "name": "danciben",
  "version": "1.0.0",
  "description": "單字本：中英雙向查詢與複習",
  "author": "ArchieKUO",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win zip --publish never"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "tw.archiekuo.danciben",
    "productName": "Danciben",
    "copyright": "ArchieKUO",
    "files": [
      "main.js",
      "preload.js",
      "www/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "zip",
      "icon": "www/icons/icon-512.png"
    },
    "artifactName": "danciben-windows.zip",
    "compression": "maximum"
  }
}
